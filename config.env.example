# Copy to config.env and edit. config.env is gitignored.

# Console address on your LAN.
ORBIS_CONSOLE=192.0.2.1

# GoldHEN's FTP port. 2121 is the GoldHEN default; stock PS4 FTP payloads often use 1337.
ORBIS_FTP_PORT=2121

# UDP port the title's netlog() sends to, and this host binds for capture.
PS4_LOG_PORT=18194

# GoldHEN klog server (TCP). Fallback channel; catches panics the title never logs itself.
PS4_KLOG_PORT=3232
