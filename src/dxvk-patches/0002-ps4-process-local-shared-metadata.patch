 namespace dxvk {
 
+  /* PS4 (Orbis-Win): \\.\SharedGpuResource is a Proton device. Upstream Wine
+   * does not provide it -- Wine 11 carries shared resources through D3DKMT,
+   * which gives DXVK the shared HANDLE but not this metadata sidecar. Without
+   * it ExportImageInfo warns "Failed to write shared resource info" and a
+   * second D3D11 device can never open the texture: Risk of Rain 2 renders,
+   * reaches 2% of its load and every thread parks for good (2026-11-16).
+   *
+   * The device exists to carry metadata BETWEEN PROCESSES. On this console
+   * everything -- both D3D11 devices, and the wineserver itself -- lives in
+   * one process, so a process-local store is an exact substitute. The real
+   * device is still tried first, so on Proton nothing below ever runs. */
+  namespace {
+    struct LocalSharedStore {
+      std::mutex                                            lock;
+      std::unordered_map<HANDLE, uintptr_t>                 handles;  // our handle -> kmt handle
+      std::unordered_map<uintptr_t, std::vector<uint8_t>>   meta;     // kmt handle -> metadata
+
+      static LocalSharedStore& get() { static LocalSharedStore s; return s; }
+    };
+
+    HANDLE localOpenKmtHandle(HANDLE kmt_handle) {
+      // A real kernel handle, so the caller's CloseHandle stays valid.
+      HANDLE h = ::CreateEventA(nullptr, FALSE, FALSE, nullptr);
+      if (!h || h == INVALID_HANDLE_VALUE)
+        return INVALID_HANDLE_VALUE;
+      auto& st = LocalSharedStore::get();
+      std::lock_guard<std::mutex> guard(st.lock);
+      st.handles[h] = reinterpret_cast<uintptr_t>(kmt_handle);
+      return h;
+    }
+
+    bool localSetMetadata(HANDLE handle, void* buf, uint32_t bufSize) {
+      auto& st = LocalSharedStore::get();
+      std::lock_guard<std::mutex> guard(st.lock);
+      auto it = st.handles.find(handle);
+      if (it == st.handles.end())
+        return false;
+      auto* src = reinterpret_cast<const uint8_t*>(buf);
+      st.meta[it->second].assign(src, src + bufSize);
+      return true;
+    }
+
+    bool localGetMetadata(HANDLE handle, void* buf, uint32_t bufSize, uint32_t* metadataSize) {
+      auto& st = LocalSharedStore::get();
+      std::lock_guard<std::mutex> guard(st.lock);
+      auto it = st.handles.find(handle);
+      if (it == st.handles.end())
+        return false;
+      auto blob = st.meta.find(it->second);
+      if (blob == st.meta.end())
+        return false;
+      const uint32_t size = std::min<uint32_t>(bufSize, uint32_t(blob->second.size()));
+      std::memcpy(buf, blob->second.data(), size);
+      if (metadataSize)
+        *metadataSize = size;
+      return true;
+    }
+  }
+
