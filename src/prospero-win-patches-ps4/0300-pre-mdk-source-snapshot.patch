@@ -0,0 +1,68 @@
+From: Codex <codex@localhost>
+Subject: ntdll: trace PS4 page-fault resolution boundary
+
+Write the raw page-fault state to the PS4 kernel log immediately before and
+after virtual_handle_fault(). This catches faults that recurse before Wine's
+normal exception logger or server dispatch can run. Keep the trace bounded.
+
+---
+diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
+index 0000000..0000000 100644
+--- a/dlls/ntdll/unix/signal_x86_64.c
++++ b/dlls/ntdll/unix/signal_x86_64.c
+@@ -3270,13 +3270,49 @@ static void __attribute__((used)) segv_handler( int signal, siginfo_t *siginfo,
+     case TRAP_x86_PAGEFLT:  /* Page fault */
+         rec.NumberParameters = 2;
+         rec.ExceptionInformation[0] = (ERROR_sig(sigcontext) >> 1) & 0x09;
+         rec.ExceptionInformation[1] = (ULONG_PTR)siginfo->si_addr;
++        {
++            static unsigned int trace_count;
++            unsigned int n = __atomic_add_fetch( &trace_count, 1, __ATOMIC_RELAXED );
++            BOOL handled, invalid_gs;
++
++            if (n <= 12)
++            {
++                extern int sceKernelDebugOutText( int channel, const char *text );
++                char line[256];
++
++                snprintf( line, sizeof(line),
++                          "ntdll ps4-pageflt-before n=%u tid=%04x data=%p teb=%p sig=%d code=%d addr=%p rip=%p rsp=%p trap=%ld err=%lx access=%lu fault=%p\n",
++                          n, data ? data->tid : 0, data, data ? data->teb : NULL,
++                          signal, siginfo ? siginfo->si_code : 0,
++                          siginfo ? siginfo->si_addr : NULL,
++                          (void *)RIP_sig(sigcontext), (void *)RSP_sig(sigcontext),
++                          (long)TRAP_sig(sigcontext), (unsigned long)ERROR_sig(sigcontext),
++                          (unsigned long)rec.ExceptionInformation[0],
++                          (void *)rec.ExceptionInformation[1] );
++                sceKernelDebugOutText( 0, line );
++            }
++
++            handled = virtual_handle_fault( data, &rec, (void *)RSP_sig(sigcontext) );
++            invalid_gs = handled ? check_invalid_gsbase( data, sigcontext ) : FALSE;
++            if (n <= 12)
++            {
++                extern int sceKernelDebugOutText( int channel, const char *text );
++                char line[192];
++
++                snprintf( line, sizeof(line),
++                          "ntdll ps4-pageflt-after n=%u handled=%d invalid_gs=%d exception=%08x addr=%p info0=%p info1=%p\n",
++                          n, handled, invalid_gs, rec.ExceptionCode, rec.ExceptionAddress,
++                          (void *)rec.ExceptionInformation[0],
++                          (void *)rec.ExceptionInformation[1] );
++                sceKernelDebugOutText( 0, line );
++            }
++            if (!handled || invalid_gs)
++            {
++                leave_handler( data, sigcontext );
++                return;
++            }
++        }
+-        if (!virtual_handle_fault( data, &rec, (void *)RSP_sig(sigcontext) ) ||
+-            check_invalid_gsbase( data, sigcontext ))
+-        {
+-            leave_handler( data, sigcontext );
+-            return;
+-        }
+         if (rec.ExceptionCode == EXCEPTION_ACCESS_VIOLATION &&
+             rec.ExceptionInformation[0] == EXCEPTION_EXECUTE_FAULT)
+         {
diff --git a/wine/patches/0993-ntdll-stop-reading-faulting-signal-stack.patch b/wine/patches/0993-ntdll-stop-reading-faulting-signal-stack.patch
new file mode 100644
index 0000000000000000000000000000000000000000..914caa943bf22fc79042d44520f687a23eba53a3
--- /dev/null
+++ b/wine/patches/0993-ntdll-stop-reading-faulting-signal-stack.patch
@@ -0,0 +1,34 @@
+From: Codex <codex@localhost>
+Subject: ntdll: stop reading faulting PS4 signal stack
+
+The raw signal trace may run while the interrupted RSP is invalid. Keep the
+register record, but do not dereference that untrusted stack from the handler.
+
+---
+diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
+index 0000000..0000000 100644
+--- a/dlls/ntdll/unix/signal_x86_64.c
++++ b/dlls/ntdll/unix/signal_x86_64.c
+@@ -3110,10 +3110,8 @@ static void __attribute__((used)) segv_handler( int signal, siginfo_t *siginfo,
+         unsigned int n = __atomic_add_fetch( &trace_count, 1, __ATOMIC_RELAXED );
+         if (n <= 4)
+         {
+             extern int sceKernelDebugOutText( int channel, const char *text );
+-            uint64_t *frame = (uint64_t *)(uintptr_t)RSP_sig(sigcontext);
+             char line[192];
+-            unsigned int i;
+ 
+             snprintf( line, sizeof(line),
+                       "ntdll ps4-sig-fault-frame n=%u sig=%d code=%d addr=%p rip=%llx rsp=%llx cs=%x ss=%x flags=%llx trap=%lld err=%llx\n",
+@@ -3131,11 +3129,5 @@ static void __attribute__((used)) segv_handler( int signal, siginfo_t *siginfo,
+                       (long long)TRAP_sig(sigcontext),
+                       (unsigned long long)ERROR_sig(sigcontext) );
+             sceKernelDebugOutText( 0, line );
+-            for (i = 0; i < 5; i++)
+-            {
+-                snprintf( line, sizeof(line), "ntdll ps4-sig-fault-stack n=%u [%u]=%016llx\n",
+-                          n, i, (unsigned long long)frame[i] );
+-                sceKernelDebugOutText( 0, line );
+-            }
+         }
+     }
diff --git a/wine/patches/0994-ntdll-null-safe-exception-trace.patch b/wine/patches/0994-ntdll-null-safe-exception-trace.patch
new file mode 100644
index 0000000000000000000000000000000000000000..e656cd0fd27fc4c7bd188870689264da380b5673
--- /dev/null
+++ b/wine/patches/0994-ntdll-null-safe-exception-trace.patch
@@ -0,0 +1,34 @@
+From: Codex <codex@localhost>
+Subject: ntdll: make PS4 exception trace safe without a TEB
+
+The PS4 signal path can reach setup_raise_exception() with thread_data present
+but without a TEB. Keep the diagnostic from faulting while recording this
+state so the original exception remains visible.
+
+---
+diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
+--- a/dlls/ntdll/unix/signal_x86_64.c
++++ b/dlls/ntdll/unix/signal_x86_64.c
+@@ -1981,8 +1981,10 @@ static void setup_raise_exception( struct thread_data *data, ucontext_t *sigcontext,
+         unsigned int n = __atomic_add_fetch( &trace_count, 1, __ATOMIC_RELAXED );
+ 
+         if (n <= 24)
+-            ERR( "PW_EXCEPTION_SETUP n=%u tid=%#lx code=%08x flags=%08x addr=%p params=%u p0=%p p1=%p ctxrip=%p ctxrsp=%p sigrip=%p sigrsp=%p stack_base=%p stack_limit=%p dealloc=%p\n",
+-                 n, (ULONG_PTR)data->teb->ClientId.UniqueThread, rec->ExceptionCode,
++            ERR( "PW_EXCEPTION_SETUP n=%u data=%p teb=%p tid=%#lx code=%08x flags=%08x addr=%p params=%u p0=%p p1=%p ctxrip=%p ctxrsp=%p sigrip=%p sigrsp=%p stack_base=%p stack_limit=%p dealloc=%p\n",
++                 n, data, data ? data->teb : NULL,
++                 data && data->teb ? (ULONG_PTR)data->teb->ClientId.UniqueThread : 0,
++                 rec->ExceptionCode,
+                  rec->ExceptionFlags, rec->ExceptionAddress, rec->NumberParameters,
+                  rec->NumberParameters > 0 ? (void *)rec->ExceptionInformation[0] : NULL,
+                  rec->NumberParameters > 1 ? (void *)rec->ExceptionInformation[1] : NULL,
+@@ -1989,6 +1991,7 @@ static void setup_raise_exception( struct thread_data *data, ucontext_t *sigcontext,
+                  (void *)context->Rip, (void *)context->Rsp,
+                  (void *)RIP_sig( sigcontext ), (void *)RSP_sig( sigcontext ),
+-                 data->teb->Tib.StackBase, data->teb->Tib.StackLimit,
+-                 data->teb->DeallocationStack );
++                 data && data->teb ? data->teb->Tib.StackBase : NULL,
++                 data && data->teb ? data->teb->Tib.StackLimit : NULL,
++                 data && data->teb ? data->teb->DeallocationStack : NULL );
+     }
+ #endif
diff --git a/wine/patches/0995-ntdll-trace-system-thread-stack.patch b/wine/patches/0995-ntdll-trace-system-thread-stack.patch
new file mode 100644
index 0000000000000000000000000000000000000000..00f506bf0bb7743898e3f684b17d31315f8058c9
--- /dev/null
+++ b/wine/patches/0995-ntdll-trace-system-thread-stack.patch
@@ -0,0 +1,66 @@
+From: Codex <codex@localhost>
+Subject: ntdll: trace stack for system-thread faults
+
+Log the supplied Wine system-thread stack and callback at startup. On a
+stack-underflow fault, include the saved pthread identity and a bounded frame
+chain from the allocated thread-data region. This distinguishes a bad stack
+start from a later stack overrun and identifies the system-thread routine.
+
+---
+--- a/dlls/ntdll/unix/server.c
++++ b/dlls/ntdll/unix/server.c
+@@ -2527,6 +2527,14 @@
+     data->pthread_id = pthread_self();
+     pthread_setspecific( thread_data_key, data );
+ #ifdef __PROSPERO__
++    if (!data->teb)
++    {
++        ULONG_PTR rsp;
++        __asm__ volatile( "movq %%rsp,%0" : "=r" (rsp) );
++        ERR( "PW_SYSTEM_THREAD_STACK tid=%04x data=%p pthread=%p start=%p param=%p rsp=%p stack=%p-%p\n",
++             (unsigned)data->tid, data, (void *)(ULONG_PTR)data->pthread_id, data->start, data->param,
++             (void *)rsp, get_kernel_stack(data), (char *)get_kernel_stack(data) + kernel_stack_size );
++    }
+     /* ⚠ DIAGNOSTIC: see spawn_thread in dlls/ntdll/unix/thread.c. A 32-bit
+      * thread never reaches wow64, and nothing between pthread_create and
+      * BTCpuThreadInit says a word. These lines are that stretch. */
+--- a/dlls/ntdll/unix/signal_x86_64.c
++++ b/dlls/ntdll/unix/signal_x86_64.c
+@@ -2734,6 +2734,8 @@
+         ULONG_PTR data_low = (ULONG_PTR)data;
+         ULONG_PTR data_high = data_low + signal_stack_mask + 1 + kernel_stack_size;
+         ULONG_PTR caller = 0;
++        ULONG_PTR frame = context->Rbp;
++        unsigned int depth;
+ 
+         /* A faulting RBP can be corrupt. Read its saved return address only
+          * when the slot is still inside the allocation associated with this
+@@ -2741,10 +2743,24 @@
+         if (context->Rbp >= data_low && context->Rbp <= data_high - 2 * sizeof(ULONG_PTR))
+             caller = *(ULONG_PTR *)(context->Rbp + sizeof(ULONG_PTR));
+ 
+-        ERR_(seh)( "PW_FAULT_STACK tid=%04x data=%p teb=%p stack=%p-%p rsp=%p rbp=%p caller=%p\n",
+-                   (unsigned)data->tid, data, data->teb, (void *)stack_low,
+-                   (void *)stack_high, (void *)context->Rsp, (void *)context->Rbp,
+-                   (void *)caller );
++        ERR_(seh)( "PW_FAULT_STACK tid=%04x data=%p teb=%p pthread=%p start=%p param=%p stack=%p-%p rsp=%p rbp=%p caller=%p\n",
++                   (unsigned)data->tid, data, data->teb, (void *)(ULONG_PTR)data->pthread_id,
++                   data->start, data->param, (void *)stack_low, (void *)stack_high,
++                   (void *)context->Rsp, (void *)context->Rbp, (void *)caller );
++        for (depth = 0; depth < 6; depth++)
++        {
++            ULONG_PTR previous, ret;
++
++            if ((frame & (sizeof(ULONG_PTR) - 1)) || frame < data_low ||
++                frame > data_high - 2 * sizeof(ULONG_PTR)) break;
++            previous = *(const volatile ULONG_PTR *)frame;
++            ret = *(const volatile ULONG_PTR *)(frame + sizeof(ULONG_PTR));
++            ERR_(seh)( "PW_FAULT_FRAME depth=%u fp=%p prev=%p ret=%p\n",
++                       depth, (void *)frame, (void *)previous, (void *)ret );
++            if (previous <= frame || previous >= stack_high - 2 * sizeof(ULONG_PTR) ||
++                previous - frame > kernel_stack_size) break;
++            frame = previous;
++        }
+         if (caller)
+         {
+             char caller_module[256];
