diff --git a/wine/patches/0868-dinput-rate-limit-ps4-acquire-trace.patch b/wine/patches/0868-dinput-rate-limit-ps4-acquire-trace.patch
new file mode 100644
index 0000000000000000000000000000000000000000..77bf1e456707742b32f10f189f704e6629331ddd
--- /dev/null
+++ b/wine/patches/0868-dinput-rate-limit-ps4-acquire-trace.patch
@@ -0,0 +1,33 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Codex <codex@localhost>
+Date: Thu, 15 Oct 2026 08:25:00 -0700
+Subject: [PATCH] dinput: rate limit PS4 acquire trace
+
+Oblivion retries Acquire every frame after its devices are acquired. Keep
+logging the first acquisition and failures, but report repeated DI_NOEFFECT
+results at most once per second so diagnostics do not flood the console log.
+---
+diff --git a/dlls/dinput/device.c b/dlls/dinput/device.c
+--- a/dlls/dinput/device.c
++++ b/dlls/dinput/device.c
+@@ -477,4 +477,5 @@ static HRESULT WINAPI dinput_device_Acquire( IDirectInputDevice8W *iface )
+     HRESULT hr = DI_OK;
+     DWORD pid;
++    static DWORD last_acquire_log;
+ 
+     TRACE( "iface %p.\n", iface );
+@@ -496,5 +497,9 @@ static HRESULT WINAPI dinput_device_Acquire( IDirectInputDevice8W *iface )
+     LeaveCriticalSection( &impl->crit );
+     if (hr == DI_OK) dinput_hooks_acquire_device( iface );
+-    WARN( "PS4-DI acquire type=%#lx hr=%#lx status=%d coop=%#lx tid=%lu\n",
+-          impl->instance.dwDevType, hr, impl->status, impl->dwCoopLevel, GetCurrentThreadId() );
++    if (hr != DI_NOEFFECT || GetTickCount() - last_acquire_log >= 1000)
++    {
++        last_acquire_log = GetTickCount();
++        WARN( "PS4-DI acquire type=%#lx hr=%#lx status=%d coop=%#lx tid=%lu\n",
++              impl->instance.dwDevType, hr, impl->status, impl->dwCoopLevel, GetCurrentThreadId() );
++    }
+     return hr;
+ }
+-- 
+2.43.0
diff --git a/wine/patches/0869-dinput-trace-ps4-event-pump-latency.patch b/wine/patches/0869-dinput-trace-ps4-event-pump-latency.patch
new file mode 100644
index 0000000000000000000000000000000000000000..abdcf47093dfac418cc2425cd935e3b249e6666e
--- /dev/null
+++ b/wine/patches/0869-dinput-trace-ps4-event-pump-latency.patch
@@ -0,0 +1,39 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Codex <codex@localhost>
+Date: Thu, 15 Oct 2026 08:30:00 -0700
+Subject: [PATCH] dinput: trace slow PS4 event-pump calls
+
+GetDeviceData can call check_dinput_events through the keyboard poll hook.
+Measure the zero-timeout message pump and report only calls taking at least
+5 ms, rate-limited to keep the trace quiet during normal polling.
+---
+--- a/dlls/dinput/dinput_main.c
++++ b/dlls/dinput/dinput_main.c
+@@ -495,6 +495,8 @@
+ 
+ void check_dinput_events(void)
+ {
++    static DWORD last_slow_log;
++    DWORD start, result, elapsed;
+     /* Windows does not do that, but our current implementation of winex11
+      * requires periodic event polling to forward events to the wineserver.
+      *
+@@ -506,7 +508,15 @@
+      * - some games do not explicitly poll for keyboard events
+      *   (for example Morrowind in its key binding page)
+      */
+-    MsgWaitForMultipleObjectsEx(0, NULL, 0, QS_ALLINPUT, 0);
++    start = GetTickCount();
++    result = MsgWaitForMultipleObjectsEx(0, NULL, 0, QS_ALLINPUT, 0);
++    elapsed = GetTickCount() - start;
++    if (elapsed >= 5 && GetTickCount() - last_slow_log >= 250)
++    {
++        last_slow_log = GetTickCount();
++        WARN( "PS4-DI slow event pump result=%#lx ms=%lu tid=%lu\n",
++              result, elapsed, GetCurrentThreadId() );
++    }
+ }
+ 
+ BOOL WINAPI DllMain( HINSTANCE inst, DWORD reason, void *reserved )
+-- 
+2.43.0
diff --git a/wine/patches/0872-ntdll-ps4-freebsd-signal-context-layout.patch b/wine/patches/0872-ntdll-ps4-freebsd-signal-context-layout.patch
new file mode 100644
index 0000000000000000000000000000000000000000..2181d19cd3f53ff3c67bf2ffa351ff0c1e5c6b61
--- /dev/null
+++ b/wine/patches/0872-ntdll-ps4-freebsd-signal-context-layout.patch
@@ -0,0 +1,45 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Codex <codex@localhost>
+Subject: [PATCH] ntdll: model Orbis signal frames with FreeBSD amd64 fields
+
+The SDK's mcontext_t is musl's gregs/fpregs structure, but the Orbis kernel
+passes the FreeBSD amd64 signal-frame layout Wine already expects. Declare
+that layout locally and keep the measured ucontext offset, so signal register
+access builds against the SDK without changing the kernel ABI assumptions.
+---
+--- a/dlls/ntdll/unix/signal_x86_64.c
++++ b/dlls/ntdll/unix/signal_x86_64.c
+@@ -242,10 +242,27 @@
+ #elif defined(__FreeBSD__) || defined (__FreeBSD_kernel__)
+ 
+ #ifdef __PROSPERO__
+-/* Measured on PS5 FW 12.02: the kernel stores FreeBSD's amd64 mcontext_t
+- * unchanged, but at ucontext offset 64 rather than the 16 the SDK header
+- * declares for uc_mcontext. */
+-# define UCONTEXT_MC(context) (*(mcontext_t *)((char *)(context) + 64))
++/* Orbis exposes musl's mcontext_t, while the kernel signal frame uses the
++ * FreeBSD/amd64 layout. Keep the ABI layout explicit instead of relying on
++ * fields that are absent from the SDK type. The kernel places this structure
++ * at ucontext offset 64. */
++typedef struct
++{
++    uint64_t mc_onstack;
++    uint64_t mc_rdi, mc_rsi, mc_rdx, mc_rcx, mc_r8, mc_r9, mc_rax;
++    uint64_t mc_rbx, mc_rbp, mc_r10, mc_r11, mc_r12, mc_r13, mc_r14, mc_r15;
++    uint32_t mc_trapno;
++    uint16_t mc_fs, mc_gs;
++    uint64_t mc_addr;
++    uint32_t mc_flags;
++    uint16_t mc_es, mc_ds;
++    uint64_t mc_err, mc_rip, mc_cs, mc_rflags, mc_rsp, mc_ss;
++    int64_t mc_len, mc_fpformat, mc_ownedfp;
++    int64_t mc_fpstate[64] __attribute__((aligned(16)));
++    uint64_t mc_fsbase, mc_gsbase, mc_xfpustate, mc_xfpustate_len, mc_tlsbase;
++    uint64_t mc_spare[3];
++} pw_ps5_mcontext_t;
++# define UCONTEXT_MC(context) (*(pw_ps5_mcontext_t *)((char *)(context) + 64))
+ /* The SDK exports sysarch() but not the amd64_{get,set}_{fs,gs}base wrappers,
+  * and its machine/sysarch.h lacks the operation numbers (FreeBSD's values,
+  * verified on the console). */
+-- 
+2.43.0
