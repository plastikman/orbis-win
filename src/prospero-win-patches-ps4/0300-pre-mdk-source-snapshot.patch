diff --git a/wine/patches/1006-win32u-trace-ps4-zero-timeout-surface-flush.patch b/wine/patches/1006-win32u-trace-ps4-zero-timeout-surface-flush.patch
new file mode 100644
index 0000000000000000000000000000000000000000..f58146be1e9e960f99cad81d1f872dbe51f62f13
--- /dev/null
+++ b/wine/patches/1006-win32u-trace-ps4-zero-timeout-surface-flush.patch
@@ -0,0 +1,75 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Codex <codex@localhost>
+Subject: [PATCH] win32u: split PS4 zero-timeout input pump timing
+
+The DirectInput probe measures long zero-timeout MsgWaitForMultipleObjectsEx
+calls, but not which part is slow. Time the PS4 surface flush and Wine message
+handling separately, and emit sparse phase markers to identify a wait that
+does not return. Other wait_objects calls keep the original path.
+---
+diff --git a/dlls/win32u/message.c b/dlls/win32u/message.c
+index 8c9a2aaef7..8f1b17370f 100644
+--- a/dlls/win32u/message.c
++++ b/dlls/win32u/message.c
+@@ -3454,11 +3454,57 @@ static DWORD wait_message( DWORD count, const HANDLE *handles, DWORD timeout, DW
+ static DWORD wait_objects( DWORD count, const HANDLE *handles, DWORD timeout,
+                            DWORD wake_mask, DWORD changed_mask, DWORD flags )
+ {
