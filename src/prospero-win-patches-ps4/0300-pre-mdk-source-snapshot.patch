+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Codex <codex@localhost>
+Subject: [PATCH] win32u: bound PS4 message-wait phase logging
+
+The 0905 trace emitted one log per inner wait-loop iteration and overwhelmed
+runtime logging when the queue stayed signaled. Aggregate phase times and emit
+one throttled summary only for slow calls or repeated queue wakeups.
+---
+diff --git a/dlls/win32u/message.c b/dlls/win32u/message.c
+index df748e935d..84a2671956 100644
+--- a/dlls/win32u/message.c
++++ b/dlls/win32u/message.c
+@@ -3412,55 +3412,47 @@ static DWORD wait_message( DWORD count, const HANDLE *handles, DWORD timeout, DW
+     ULONG ret_len;
+     HANDLE event;
+     static DWORD last_probe_log;
+-    DWORD ret, start, elapsed;
+-    BOOL log_probe = !timeout && count == 1 && !wake_mask && changed_mask == QS_ALLINPUT && !flags &&
+-                     (!last_probe_log || NtGetTickCount() - last_probe_log >= 1000);
++    DWORD ret, start, total_start, elapsed, callback_before_ms = 0, driver_ms = 0;
++    DWORD idle_ms = 0, kernel_wait_ms = 0, repeat_driver_ms = 0, callback_after_ms = 0;
++    DWORD repeat_count = 0, total_ms;
++    BOOL more;
++    BOOL probe = !timeout && count == 1 && !wake_mask && changed_mask == QS_ALLINPUT && !flags;
+ 
+-    if (log_probe) last_probe_log = NtGetTickCount();
++    total_start = probe ? NtGetTickCount() : 0;
+     if ((abs = get_nt_timeout( &time, timeout )))
+     {
+         NtQuerySystemTime( &now );
+         abs->QuadPart = now.QuadPart - abs->QuadPart;
+     }
+ 
+-    if (log_probe) WARN( "PS4-DI message phase=callback-before-begin tid=%u\n", GetCurrentThreadId() );
+-    start = NtGetTickCount();
++    if (probe) start = NtGetTickCount();
+     if (!KeUserDispatchCallback( &params.dispatch, sizeof(params), &ret_ptr, &ret_len ) &&
+         ret_len == sizeof(params.locks))
+     {
+         params.locks = *(DWORD *)ret_ptr;
+         params.restore = TRUE;
+     }
+-    elapsed = NtGetTickCount() - start;
+-    if (log_probe) WARN( "PS4-DI message phase=callback-before-end ms=%u tid=%u\n", elapsed, GetCurrentThreadId() );
++    if (probe) callback_before_ms = NtGetTickCount() - start;
+ 
+-    if (log_probe) WARN( "PS4-DI message phase=driver-events-begin tid=%u\n", GetCurrentThreadId() );
+-    start = NtGetTickCount();
++    if (probe) start = NtGetTickCount();
+     process_driver_events( QS_ALLINPUT, wake_mask, changed_mask );
+-    elapsed = NtGetTickCount() - start;
+-    if (log_probe) WARN( "PS4-DI message phase=driver-events-end ms=%u tid=%u\n", elapsed, GetCurrentThreadId() );
++    if (probe) driver_ms = NtGetTickCount() - start;
+ 
+-    if (log_probe) WARN( "PS4-DI message phase=idle-event-begin tid=%u\n", GetCurrentThreadId() );
+-    start = NtGetTickCount();
++    if (probe) start = NtGetTickCount();
+     if (!(changed_mask & QS_SMRESULT) && (event = get_user_thread_info()->idle_event)) NtSetEvent( event, NULL );
+-    elapsed = NtGetTickCount() - start;
+-    if (log_probe) WARN( "PS4-DI message phase=idle-event-end ms=%u tid=%u\n", elapsed, GetCurrentThreadId() );
++    if (probe) idle_ms = NtGetTickCount() - start;
+ 
+-    if (log_probe) WARN( "PS4-DI message phase=kernel-wait-begin tid=%u\n", GetCurrentThreadId() );
+     do
+     {
+-        start = NtGetTickCount();
++        if (probe) start = NtGetTickCount();
+         ret = NtWaitForMultipleObjects( count, handles, type, !!(flags & MWMO_ALERTABLE), abs );
+-        elapsed = NtGetTickCount() - start;
+-        if (log_probe) WARN( "PS4-DI message phase=kernel-wait-end ms=%u result=%#x tid=%u\n",
+-                             elapsed, ret, GetCurrentThreadId() );
++        if (probe) kernel_wait_ms += NtGetTickCount() - start;
+         if (ret != count - 1) break;
+-        if (log_probe) WARN( "PS4-DI message phase=driver-events-repeat-begin tid=%u\n", GetCurrentThreadId() );
+-        start = NtGetTickCount();
+-        if (process_driver_events( QS_ALLINPUT, wake_mask, changed_mask )) break;
+-        elapsed = NtGetTickCount() - start;
+-        if (log_probe) WARN( "PS4-DI message phase=driver-events-repeat-end ms=%u tid=%u\n",
+-                             elapsed, GetCurrentThreadId() );
++        repeat_count++;
++        if (probe) start = NtGetTickCount();
++        more = process_driver_events( QS_ALLINPUT, wake_mask, changed_mask );
++        if (probe) repeat_driver_ms += NtGetTickCount() - start;
++        if (more) break;
+     }
+     while (ret == count - 1);
+ 
+@@ -3473,11 +3465,25 @@ static DWORD wait_message( DWORD count, const HANDLE *handles, DWORD timeout, DW
+     if (ret == WAIT_TIMEOUT && !count && !timeout) NtYieldExecution();
+     if (ret == count - 1) get_user_thread_info()->last_driver_time = get_driver_check_time();
+ 
+-    if (log_probe) WARN( "PS4-DI message phase=callback-after-begin tid=%u\n", GetCurrentThreadId() );
+-    start = NtGetTickCount();
++    if (probe) start = NtGetTickCount();
+     KeUserDispatchCallback( &params.dispatch, sizeof(params), &ret_ptr, &ret_len );
+-    elapsed = NtGetTickCount() - start;
+-    if (log_probe) WARN( "PS4-DI message phase=callback-after-end ms=%u tid=%u\n", elapsed, GetCurrentThreadId() );
++    if (probe) callback_after_ms = NtGetTickCount() - start;
++
++    if (probe)
++    {
++        total_ms = NtGetTickCount() - total_start;
++        if ((total_ms >= 20 || repeat_count > 1) &&
++            (!last_probe_log || NtGetTickCount() - last_probe_log >= 250))
++        {
++            last_probe_log = NtGetTickCount();
++            elapsed = driver_ms + repeat_driver_ms;
++            WARN( "PS4-DI message summary total_ms=%u callback_before_ms=%u driver_ms=%u idle_ms=%u "
++                  "kernel_wait_ms=%u repeat_driver_ms=%u repeat_count=%u callback_after_ms=%u "
++                  "driver_total_ms=%u result=%#x tid=%u\n",
++                  total_ms, callback_before_ms, driver_ms, idle_ms, kernel_wait_ms,
++                  repeat_driver_ms, repeat_count, callback_after_ms, elapsed, ret, GetCurrentThreadId() );
++        }
++    }
+ 
+     return ret;
+ }
+--
+2.43.0
diff --git a/wine/patches/0907-win32u-bound-zero-timeout-queue-wait.patch b/wine/patches/0907-win32u-bound-zero-timeout-queue-wait.patch
new file mode 100644
index 0000000000000000000000000000000000000000..4a3ac5b951c1a125070820a6a0ff6aff5c498e64
--- /dev/null
+++ b/wine/patches/0907-win32u-bound-zero-timeout-queue-wait.patch
@@ -0,0 +1,27 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Codex <codex@localhost>
+Date: Thu, 15 Oct 2026 11:50:00 -0700
+Subject: [PATCH] win32u: bound zero-timeout queue wait retries
+
+A zero-timeout message poll can repeatedly observe a signaled server queue
+while process_driver_events() reports no matching input. The absolute timeout
+does not stop NtWaitForMultipleObjects from returning the signaled queue again,
+so the poll spins until the queue changes. Return WAIT_TIMEOUT after processing
+that stale wake once; real driver events still return through the existing path.
+---
+diff --git a/dlls/win32u/message.c b/dlls/win32u/message.c
+--- a/dlls/win32u/message.c
++++ b/dlls/win32u/message.c
+@@ -3464,4 +3464,10 @@ static DWORD wait_message( DWORD count, const HANDLE *handles, DWORD timeout, DW
+         if (probe) repeat_driver_ms += NtGetTickCount() - start;
+         if (more) break;
++        /* A zero-timeout poll must not spin while the server queue stays signaled. */
++        if (!timeout)
++        {
++            ret = WAIT_TIMEOUT;
++            break;
++        }
+     }
+     while (ret == count - 1);
+-- 
+2.43.0
diff --git a/wine/patches/0908-ntdll-ps4-directory-enumeration-getdents.patch b/wine/patches/0908-ntdll-ps4-directory-enumeration-getdents.patch
new file mode 100644
index 0000000000000000000000000000000000000000..f405c72b13f5d2a4af7dfd501cc687cb66bf59be
--- /dev/null
+++ b/wine/patches/0908-ntdll-ps4-directory-enumeration-getdents.patch
@@ -0,0 +1,87 @@
+From 8d730e47a5a4f5db690a8232f4f8b313e21cc401 Mon Sep 17 00:00:00 2001
+From: Codex <codex@localhost>
+Date: Thu, 15 Oct 2026 13:00:00 -0700
+Subject: [PATCH] ntdll: enumerate PS4 directories with getdents
+
+Keep the server-side directory name when realpath cannot canonicalize an
+openable PS4 path. NtQueryDirectoryFile needs that name when the PS4 working
+directory wrapper cannot fchdir() a wineserver descriptor.
+
+Use the shared PS4 directory scanner for NtQueryDirectoryFile. The PS4 libc
+readdir path fails on its 64 KiB directory blocks; the scanner uses getdents
+with the block size the filesystem expects.
+
+---
+--- a/server/fd.c
++++ b/server/fd.c
+@@ -2055,7 +2055,15 @@
+ {
+     char resolved[PATH_MAX];
+ 
+-    return realpath( path, resolved ) ? strdup( resolved ) : NULL;
++    if (realpath( path, resolved )) return strdup( resolved );
++#ifdef __PROSPERO__
++    /* A directory fd still needs a name when the console's libc cannot
++     * canonicalize an otherwise openable path. ntdll uses this name to enter
++     * the directory when it cannot fchdir() a descriptor from wineserver. */
++    return strdup( path );
++#else
++    return NULL;
++#endif
+ }
+ 
+ char *dup_fd_name( struct fd *root, const char *name )
+--- a/dlls/ntdll/unix/file.c
++++ b/dlls/ntdll/unix/file.c
+@@ -2697,8 +2697,41 @@
+  *
+  * Read a directory using the POSIX readdir interface; helper for NtQueryDirectoryFile.
+  */
++#ifdef __PROSPERO__
++struct append_directory_context
++{
++    struct dir_data *data;
++    const UNICODE_STRING *mask;
++};
++
++static int append_directory_entry( const char *name, void *context_ptr )
++{
++    struct append_directory_context *context = context_ptr;
++
++    if (!append_entry( context->data, name, NULL, context->mask ))
++    {
++        errno = ENOMEM;
++        return -1;
++    }
++    return 0;
++}
++#endif
++
+ static NTSTATUS read_directory_data_readdir( struct dir_data *data, const UNICODE_STRING *mask )
+ {
++#ifdef __PROSPERO__
++    struct append_directory_context context = { data, mask };
++    unsigned int flags;
++    extern int pw_cwd_scan_directory( int dirfd, const char *path,
++                                      int (*visit)( const char *name, void *context ),
++                                      void *context, unsigned int *flags );
++    /* libc readdir() can fail with EINVAL for the console's 64 KiB directory
++     * blocks. The shared PS4 directory scanner uses getdents() with the
++     * required block-sized buffer and caches stable listings. */
++    if (pw_cwd_scan_directory( AT_FDCWD, ".", append_directory_entry, &context, &flags ))
++        return errno_to_status( errno );
++    return STATUS_SUCCESS;
++#else
+     struct dirent *de;
+     NTSTATUS status = STATUS_NO_MEMORY;
+     DIR *dir = opendir( "." );
+@@ -2717,6 +2750,7 @@
+ done:
+     closedir( dir );
+     return status;
++#endif
+ }
+ 
+ 
+-- 
+2.39.5
diff --git a/wine/patches/0975-win32u-trace-vulkan-hardware-cursor.patch b/wine/patches/0975-win32u-trace-vulkan-hardware-cursor.patch
new file mode 100644
index 0000000000000000000000000000000000000000..318af53e7489ef7d7d54396ae78a77996efb67f7
--- /dev/null
+++ b/wine/patches/0975-win32u-trace-vulkan-hardware-cursor.patch
@@ -0,0 +1,51 @@
+From: Codex <codex@localhost>
+Subject: win32u: Trace PS5 Vulkan hardware cursor handoff
+
+Report the first cursor state passed from Wine to VideoOut, changes in
+visibility, and changes in the return status. This distinguishes a game that
+keeps its Windows cursor hidden from a failed VideoOut hardware-cursor call
+without logging once per presented frame.
+
+---
+diff --git a/dlls/win32u/ps5drv.c b/dlls/win32u/ps5drv.c
+--- a/dlls/win32u/ps5drv.c
++++ b/dlls/win32u/ps5drv.c
+@@ -741,5 +741,7 @@ void ps5drv_vulkan_cursor( void *vulkan_handle )
+     static int (*show)( const UINT32 *, UINT, UINT, INT, INT, UINT, UINT );
+     static BOOL looked;
++    static BOOL reported, last_visible;
++    static int last_result;
+     const UINT32 *image;
+     UINT width, height;
+     POINT top_left;
+@@ -751,9 +753,26 @@ void ps5drv_vulkan_cursor( void *vulkan_handle )
+         looked = TRUE;
+         show = dlsym( vulkan_handle, "pw_videoout_cursor" );
+     }
+-    if (!show) return;
++    if (!show)
++    {
++        if (!reported) ERR( "PW_VK_CURSOR missing pw_videoout_cursor export\n" );
++        reported = TRUE;
++        return;
++    }
+     image = ps5drv_lock_cursor( &width, &height, &top_left );
+-    show( width && height ? image : NULL, width, height, top_left.x, top_left.y, screen_width, screen_height );
++    {
++        BOOL visible = image && width && height;
++        int result = show( visible ? image : NULL, width, height, top_left.x, top_left.y,
++                           screen_width, screen_height );
++
++        if (!reported || visible != last_visible || result != last_result)
++            ERR( "PW_VK_CURSOR visible=%u image=%p size=%ux%u pos=%d,%d desktop=%ux%u result=%d\n",
++                 visible, image, width, height, top_left.x, top_left.y, screen_width,
++                 screen_height, result );
++        reported = TRUE;
++        last_visible = visible;
++        last_result = result;
++    }
+     ps5drv_unlock_cursor();
+ }
+ #endif
+-- 
+2.43.0
