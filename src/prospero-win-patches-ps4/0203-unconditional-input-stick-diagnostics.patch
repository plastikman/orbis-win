From 75f25351354b866e8cae8c17e828e386651ddb7e Mon Sep 17 00:00:00 2001
From: Zak Peirce <plastikman@gmail.com>
Date: Thu, 29 Oct 2026 07:48:58 -0700
Subject: [PATCH] wine64_main: unconditional input/stick diagnostics (1049)

The 1048 stick diagnostic was gated on `deflected || count != before_stick`,
so a dead setting and frozen axes both reported as silence. Package 1049 adds
an unconditional startup line naming the merged keyboard_stick, stick_deadzone,
stick keys and set mask, plus a stick sample on the first 10 frames and every
120th after.

That line found the cause immediately: `set=0x7` on console against `0x67`
from a host parse of the same file. Two profiles on the console both declared
`id = oblivion-gog`, and pw_wine_library_load sorts by filename while
pw_wine_library_find takes the first id match -- '-' (0x2D) sorts before '.'
(0x2E), so oblivion-gog-native.profile shadowed oblivion-gog.profile. The
shadowing file also set `mouse = right_stick`, which is why the mouse worked
and the stick looked like an isolated failure.

The parser, the overlay, the pad path and the profile were all correct
throughout. Fixed by giving the variant a distinct id; the left stick now
drives WASD in Oblivion with cpu=native.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 native/pw_wine_display.c |  47 ++++++++++++++++++
 native/pw_wine_display.h |  12 +++++
 native/wine64_main.c     | 104 ++++++++++++++++++++++++++++++++++++++-
 src/pw_game_profile.c    |  53 +++++++++++++++++++-
 src/pw_game_profile.h    |  11 +++++
 5 files changed, 223 insertions(+), 4 deletions(-)

diff --git a/native/pw_wine_display.c b/native/pw_wine_display.c
index b9aaf81..e6a9609 100644
--- a/native/pw_wine_display.c
+++ b/native/pw_wine_display.c
@@ -95,6 +95,53 @@ size_t pw_wine_game_inputs(const PwGameInput *input, uint32_t pressed, uint32_t
     return add_edges(input, pressed, 1, out, used, max);
 }
 
+enum { KEY_STICK_UP = 1u << 0, KEY_STICK_DOWN = 1u << 1,
+       KEY_STICK_LEFT = 1u << 2, KEY_STICK_RIGHT = 1u << 3 };
+
+static int stick_direction(uint8_t value, int negative, int was_held, unsigned deadzone)
+{
+    /* Five raw stick counts of hysteresis keep a noisy axis from tapping the
+     * key repeatedly at the edge of its dead zone. */
+    int threshold = (int)(127u * deadzone / 100u);
+    int delta = (int)value - 128;
+    if (negative) return delta < -(threshold - (was_held ? 5 : 0));
+    return delta > threshold - (was_held ? 5 : 0);
+}
+
+size_t pw_wine_keyboard_stick_step(const PwGameInput *input, uint8_t stick_x, uint8_t stick_y,
+                                  int connected, PwWineKeyboardStick *state,
+                                  PwWineInput *out, size_t max)
+{
+    static const uint8_t bits[4] = { KEY_STICK_UP, KEY_STICK_DOWN, KEY_STICK_LEFT, KEY_STICK_RIGHT };
+    uint8_t wanted = 0, previous;
+    size_t used = 0;
+
+    if (!input || !state || !out) return 0;
+    previous = state->held;
+    if (connected && input->keyboard_stick != PW_GAME_STICK_NONE) {
+        if (stick_direction(stick_y, 1, !!(previous & KEY_STICK_UP), input->stick_deadzone))
+            wanted |= KEY_STICK_UP;
+        if (stick_direction(stick_y, 0, !!(previous & KEY_STICK_DOWN), input->stick_deadzone))
+            wanted |= KEY_STICK_DOWN;
+        if (stick_direction(stick_x, 1, !!(previous & KEY_STICK_LEFT), input->stick_deadzone))
+            wanted |= KEY_STICK_LEFT;
+        if (stick_direction(stick_x, 0, !!(previous & KEY_STICK_RIGHT), input->stick_deadzone))
+            wanted |= KEY_STICK_RIGHT;
+    }
+    /* Release first so a direct direction reversal cannot momentarily hold
+     * both keys. The caller reserves room for all four transitions. */
+    for (size_t i = 0; i < 4 && used < max; i++) {
+        if ((previous & bits[i]) && !(wanted & bits[i]))
+            out[used++] = (PwWineInput){ PW_WINE_INPUT_KEY, input->stick_keys[i], 0, 0, 0 };
+    }
+    for (size_t i = 0; i < 4 && used < max; i++) {
+        if (!(previous & bits[i]) && (wanted & bits[i]))
+            out[used++] = (PwWineInput){ PW_WINE_INPUT_KEY, input->stick_keys[i], 0, 0, 1 };
+    }
+    state->held = wanted;
+    return used;
+}
+
 static const struct { uint32_t dualsense; uint16_t xinput; } pad_buttons[] = {
     { 0x4000u, 0x1000u }, { 0x2000u, 0x2000u }, { 0x8000u, 0x4000u }, { 0x1000u, 0x8000u },
     { 0x400u, 0x0100u }, { 0x800u, 0x0200u }, { 0x2u, 0x0040u }, { 0x4u, 0x0080u },
diff --git a/native/pw_wine_display.h b/native/pw_wine_display.h
index c94a3e5..95f1630 100644
--- a/native/pw_wine_display.h
+++ b/native/pw_wine_display.h
@@ -52,6 +52,18 @@ int pw_wine_frame_box_take(PwWineFrameBox *box, uint64_t *seen, uint8_t *out,
 size_t pw_wine_game_inputs(const PwGameInput *input, uint32_t pressed, uint32_t released,
                            PwWineInput *out, size_t max);
 
+/* Digital key emulation for one analog stick. Direction bits are retained
+ * across frames so key-down is sent only on a threshold crossing, and every
+ * held direction is released when the controller disconnects.
+ *
+ * Restored 2026-10-28: the upstream sync removed this along with the
+ * keyboard_stick/stick_deadzone profile keys, which left Oblivion's left
+ * stick doing nothing while its buttons still worked. */
+typedef struct PwWineKeyboardStick { uint8_t held; } PwWineKeyboardStick;
+size_t pw_wine_keyboard_stick_step(const PwGameInput *input, uint8_t stick_x, uint8_t stick_y,
+                                  int connected, PwWineKeyboardStick *state,
+                                  PwWineInput *out, size_t max);
+
 /* The DualSense as an XInput gamepad: its held buttons (Cross A, Circle B,
  * Square X, Triangle Y, L1/R1 shoulders, L3/R3 thumbs, Options Start,
  * Create Back, a touchpad click Back on its left half and Guide on its
diff --git a/native/wine64_main.c b/native/wine64_main.c
index ecc4f3a..13a7b87 100644
--- a/native/wine64_main.c
+++ b/native/wine64_main.c
@@ -75,6 +75,19 @@
  * src/prospero-win-patches-ps4/0026-wine64-report-gnm-submit-done.patch,
  * dropped by the 2026-10-28 upstream merge. */
 extern int32_t sceGnmSubmitDone(void);
+#ifdef PW_RELOCATABLE_WINE
+/* Present only in the relocatable PRX build. Keep the eboot image mapped
+ * through Sony display/input setup, then release its low range immediately
+ * before Wine starts the selected Windows process.
+ *
+ * Restored 2026-10-28: the upstream sync dropped this, so the eboot stayed
+ * mapped at 0x400000-0x49c000 and sceKernelReserveVirtualRange returned
+ * ENOMEM for every fixed low reservation -- measured by vmprobe/1045 as
+ * `query ... name=executable hole=0`. FalloutNV.exe then relocated to
+ * 0x530000 (it had loaded at 0x400000 on 19 consecutive pre-sync runs) and
+ * Oblivion, which cannot relocate, died at STATUS_CONFLICTING_ADDRESSES. */
+extern int pw_relocated_wine_release_eboot(void) __attribute__((weak));
+#endif
 #ifndef PW_FIXED_PROFILE
 /* The id of the one profile a single-program title runs; "" for the launcher. */
 #define PW_FIXED_PROFILE ""
@@ -112,6 +125,19 @@ static const char *const runtime_roots[] = { "/app0", PW_SANDBOX_APP0 };
  * thread waits on every two seconds, for stalls that logging hides. */
 #define PW_WINE64_WAIT_WATCHDOG 0
 #endif
+#ifndef PW_WINE64_HEAP_FLEXIBLE
+/* A/B control: keep Wine's Unix heap on its existing anonymous mmap backing
+ * instead of PS4 direct memory. Restored 2026-10-28 -- the upstream sync left
+ * build-relocatable-wine-ps4.sh validating and passing -D for this and for
+ * PW_WINE64_SERVER_DIRECT_OFF while no source read either, so both switches
+ * looked wired and did nothing. */
+#define PW_WINE64_HEAP_FLEXIBLE 0
+#endif
+#ifndef PW_WINE64_SERVER_DIRECT_OFF
+/* A/B control: route Wine server requests through the ordinary server thread
+ * rather than the direct path, leaving the CPU backend and game data alone. */
+#define PW_WINE64_SERVER_DIRECT_OFF 0
+#endif
 #ifndef PW_WINE64_SCRIPT
 /* 1 drives the launcher unattended for validation: it opens
  * PW_WINE64_SCRIPT_CYCLES games, one per cycle in the library's order
@@ -1049,6 +1075,7 @@ int main(int argc, char **argv)
     const PwGameProfile *game = NULL;
     int scaling = PW_PRESENT_SCALE_FIT;
     PwWinePointer pointer = { 0, 0 };
+    PwWineKeyboardStick keyboard_stick_state = { 0 };
     int (*post_input)(const PwWineInput *) = NULL;
     void (*set_pad)(const PwWinePad *) = NULL;
     int (*rumble)(uint32_t *, uint32_t *) = NULL;
@@ -1109,6 +1136,16 @@ int main(int argc, char **argv)
     if (game) {
         int input_status = pw_wine_library_input(game, library_root, &game_input);
         int input2_status = pw_wine_library_player2_input(game, library_root, &game_input2);
+        /* [input] 1049: the 1048 stick diagnostic was gated on deflection, so
+         * "setting is off" and "axes frozen at centre" both came out silent.
+         * This line is unconditional and settles the first of the two. */
+        PS5LOG_LOG("PW_WINE64 input status=%s keyboard_stick=%d stick_deadzone=%u "
+                   "stick_keys=%#x,%#x,%#x,%#x keys_set=%#x mouse=%d mode=%d set=%#x",
+                   pw_result_name(input_status), (int)game_input.keyboard_stick,
+                   (unsigned)game_input.stick_deadzone, game_input.stick_keys[0],
+                   game_input.stick_keys[1], game_input.stick_keys[2], game_input.stick_keys[3],
+                   (unsigned)game_input.stick_keys_set, (int)game_input.mouse,
+                   (int)game_input.mode, (unsigned)game_input.set);
         player2 = input2_status == PW_OK;
         if (input2_status != PW_ERR_NOT_FOUND)
             PS5LOG_LOG("PW_WINE64 player2 preset=%s input=%s", game->input.player2,
@@ -1256,6 +1293,14 @@ int main(int argc, char **argv)
                        temp.count ? temp.folders[temp.count - 1] : "-");
         }
         if (PW_WINE64_WAIT_WATCHDOG) setenv("WINE_PS5_WAIT_WATCHDOG", "1", 1);
+        if (PW_WINE64_HEAP_FLEXIBLE) {
+            setenv("WINE_PS5_HEAP_FLEXIBLE", "1", 1);
+            PS5LOG_LOG("PW_WINE64 heap_direct=0 (anonymous mmap control)");
+        }
+        if (PW_WINE64_SERVER_DIRECT_OFF) {
+            setenv("WINE_PS5_SERVER_DIRECT", "0", 1);
+            PS5LOG_LOG("PW_WINE64 server_direct=0 (regular server thread)");
+        }
         /* [application] arguments follow the executable in Wine's argv. */
         int words = pw_wine_launch_split(game->app.arguments, argument_words,
                                          sizeof(argument_words), wine_argv + 2,
@@ -1382,6 +1427,15 @@ int main(int argc, char **argv)
         status = pw_wine_start_environment(&start, &config, &ops);
         PS5LOG_LOG("PW_WINE64 environment status=%d", status);
     }
+#ifdef PW_RELOCATABLE_WINE
+    if (status == PW_OK) {
+        if (game && pw_relocated_wine_release_eboot) {
+            int release_status = pw_relocated_wine_release_eboot();
+            PS5LOG_LOG("PW_WINE64 relocatable eboot release status=%d", release_status);
+            if (release_status) status = PW_ERR_STATE;
+        }
+    }
+#endif
     if (status == PW_OK) {
         status = pw_wine_start_run(&start, &config, &ops);
         PS5LOG_LOG("PW_WINE64 run status=%d", status);
@@ -1397,7 +1451,8 @@ int main(int argc, char **argv)
         uint64_t now = now_ns();
         pw_diagnostics_tick(now);
         PwPresentView view;
-        PwWineInput events[2 * PW_GAME_BUTTON_COUNT + 1];
+        /* +4 stick transitions (keyboard_stick) and +1 pointer move. */
+        PwWineInput events[2 * PW_GAME_BUTTON_COUNT + 5];
         int presented = 0;
 
         /* The USB keyboard and mouse; one plugged in later is found by a
@@ -1539,7 +1594,42 @@ int main(int argc, char **argv)
         if (pad_read) {
             size_t count = pw_wine_game_inputs(&game_input, seen->core.pressed_edges,
                                                seen->core.released_edges, events,
-                                               sizeof(events) / sizeof(events[0]) - 1);
+                                               sizeof(events) / sizeof(events[0]) - 5);
+            /* [input] keyboard_stick: one stick drives the four direction
+             * keys (WASD by default). Oblivion's profile sets left_stick. */
+            const PwPadPs5Stick *key_stick = NULL;
+            if (game_input.keyboard_stick != PW_GAME_STICK_NONE)
+                key_stick = game_input.keyboard_stick == PW_GAME_STICK_LEFT ?
+                            &seen->left_stick : &seen->right_stick;
+            size_t before_stick = count;
+            count += pw_wine_keyboard_stick_step(&game_input,
+                                                 key_stick ? key_stick->x : 0x80,
+                                                 key_stick ? key_stick->y : 0x80,
+                                                 key_stick != NULL, &keyboard_stick_state,
+                                                 &events[count],
+                                                 sizeof(events) / sizeof(events[0]) - count - 1);
+            /* Bounded: the first 40 deflections or emitted transitions. Says
+             * whether the setting is live, whether stick values arrive, and
+             * whether the step turned them into keys. */
+            {
+                static unsigned stick_logs, stick_frames;
+                int deflected = key_stick && (key_stick->x < 0x60 || key_stick->x > 0xa0 ||
+                                              key_stick->y < 0x60 || key_stick->y > 0xa0);
+                /* 1049: also sample unconditionally -- the first 10 frames and
+                 * every 120th after -- so a silent run still says whether the
+                 * setting is live and what the axes actually read. */
+                int sampled = stick_frames < 10 || stick_frames % 120 == 0;
+                stick_frames++;
+                if ((deflected || count != before_stick || sampled) && stick_logs < 60) {
+                    stick_logs++;
+                    PS5LOG_LOG("PW_WINE64 stick n=%u setting=%d x=%#x y=%#x dead=%u held=%#x events=%u",
+                               stick_logs, (int)game_input.keyboard_stick,
+                               key_stick ? key_stick->x : 0x80, key_stick ? key_stick->y : 0x80,
+                               (unsigned)game_input.stick_deadzone,
+                               (unsigned)keyboard_stick_state.held,
+                               (unsigned)(count - before_stick));
+                }
+            }
             if (game_input.mouse != PW_GAME_STICK_NONE) {
                 const PwPadPs5Stick *stick = game_input.mouse == PW_GAME_STICK_LEFT ?
                                              &seen->left_stick : &seen->right_stick;
@@ -1561,6 +1651,16 @@ int main(int argc, char **argv)
                                (unsigned)left, (unsigned)right, pw_result_name(vibrate),
                                pad.vibration_rc, pad.trigger_rc);
             }
+        } else if (keyboard_stick_state.held && post_input) {
+            /* The pad stopped reporting with directions held: release them
+             * so the game is not left walking into a wall. */
+            size_t count = pw_wine_keyboard_stick_step(&game_input, 0x80, 0x80, 0,
+                                                       &keyboard_stick_state, events,
+                                                       sizeof(events) / sizeof(events[0]));
+            for (size_t j = 0; j < count; j++) {
+                if (post_input(&events[j]) == 0) posted++;
+                else refused++;
+            }
         }
         /* The console's own keyboard: the two-finger click or the menu's
          * entry asks the system for its dialog, which it draws over the
diff --git a/src/pw_game_profile.c b/src/pw_game_profile.c
index 7769136..d3b5101 100644
--- a/src/pw_game_profile.c
+++ b/src/pw_game_profile.c
@@ -3,7 +3,11 @@
 #include <string.h>
 
 enum { SET_MODE = 1u << 0, SET_MOUSE = 1u << 1, SET_SPEED = 1u << 2, SET_PRESET = 1u << 3,
-       SET_PLAYER2 = 1u << 4 };
+       SET_PLAYER2 = 1u << 4, SET_KEYBOARD_STICK = 1u << 5, SET_STICK_DEADZONE = 1u << 6 };
+/* Restored 2026-10-28: the upstream sync dropped keyboard_stick/stick_deadzone
+ * and took bit 4 for SET_PLAYER2, so these two moved to bits 5 and 6. Without
+ * them Oblivion's profile parsed but the left stick did nothing. */
+enum { STICK_UP = 1u << 0, STICK_DOWN = 1u << 1, STICK_LEFT = 1u << 2, STICK_RIGHT = 1u << 3 };
 
 /* DualSense buttons in PW_GAME_BUTTON order, with their scePadRead bits. */
 static const struct { const char *name; uint32_t mask; } buttons[PW_GAME_BUTTON_COUNT] = {
@@ -112,6 +116,12 @@ static int preset_name(char *out, size_t capacity, const uint8_t *v, size_t n)
     return PW_OK;
 }
 
+/* The four stick directions as profile keys; defaults are WASD. */
+static const struct { const char *name; unsigned index, bit; } stick_key_names[] = {
+    { "stick_up", 0, STICK_UP }, { "stick_down", 1, STICK_DOWN },
+    { "stick_left", 2, STICK_LEFT }, { "stick_right", 3, STICK_RIGHT },
+};
+
 static int input_field(PwGameInput *input, const uint8_t *key, size_t key_length,
                        const uint8_t *v, size_t n, int allow_preset)
 {
@@ -144,6 +154,35 @@ static int input_field(PwGameInput *input, const uint8_t *key, size_t key_length
         input->set |= SET_MOUSE;
         return PW_OK;
     }
+    if (is(key, key_length, "keyboard_stick")) {
+        if (input->set & SET_KEYBOARD_STICK) return PW_ERR_MALFORMED;
+        if (is(v, n, "none")) input->keyboard_stick = PW_GAME_STICK_NONE;
+        else if (is(v, n, "left_stick")) input->keyboard_stick = PW_GAME_STICK_LEFT;
+        else if (is(v, n, "right_stick")) input->keyboard_stick = PW_GAME_STICK_RIGHT;
+        else return PW_ERR_UNSUPPORTED;
+        input->set |= SET_KEYBOARD_STICK;
+        return PW_OK;
+    }
+    if (is(key, key_length, "stick_deadzone")) {
+        uint32_t deadzone;
+        if ((input->set & SET_STICK_DEADZONE) || number(v, n, &deadzone) != PW_OK ||
+            deadzone < 5 || deadzone > 70)
+            return PW_ERR_MALFORMED;
+        input->stick_deadzone = (uint8_t)deadzone;
+        input->set |= SET_STICK_DEADZONE;
+        return PW_OK;
+    }
+    for (size_t i = 0; i < sizeof(stick_key_names) / sizeof(stick_key_names[0]); i++) {
+        PwGameBinding parsed = { 0, 0, 0 };
+        int status;
+        if (!is(key, key_length, stick_key_names[i].name)) continue;
+        if (input->stick_keys_set & stick_key_names[i].bit) return PW_ERR_MALFORMED;
+        if ((status = binding(v, n, &parsed)) != PW_OK) return status;
+        if (parsed.kind != PW_GAME_BIND_KEY) return PW_ERR_UNSUPPORTED;
+        input->stick_keys[stick_key_names[i].index] = parsed.code;
+        input->stick_keys_set |= stick_key_names[i].bit;
+        return PW_OK;
+    }
     if (is(key, key_length, "mouse_speed")) {
         uint32_t speed;
         if ((input->set & SET_SPEED) || number(v, n, &speed) != PW_OK || !speed ||
@@ -508,6 +547,11 @@ void pw_game_input_init(PwGameInput *input)
     if (!input) return;
     memset(input, 0, sizeof(*input));
     input->mouse_speed = PW_GAME_MOUSE_SPEED_DEFAULT;
+    input->stick_deadzone = 25;
+    input->stick_keys[0] = 'W';
+    input->stick_keys[1] = 'S';
+    input->stick_keys[2] = 'A';
+    input->stick_keys[3] = 'D';
     for (size_t i = 0; i < PW_GAME_BUTTON_COUNT; i++) input->bindings[i].mask = buttons[i].mask;
 }
 
@@ -561,7 +605,12 @@ void pw_game_input_overlay(PwGameInput *base, const PwGameInput *overrides)
     if (overrides->set & SET_MODE) base->mode = overrides->mode;
     if (overrides->set & SET_MOUSE) base->mouse = overrides->mouse;
     if (overrides->set & SET_SPEED) base->mouse_speed = overrides->mouse_speed;
-    base->set |= overrides->set & (SET_MODE | SET_MOUSE | SET_SPEED);
+    if (overrides->set & SET_KEYBOARD_STICK) base->keyboard_stick = overrides->keyboard_stick;
+    if (overrides->set & SET_STICK_DEADZONE) base->stick_deadzone = overrides->stick_deadzone;
+    for (size_t i = 0; i < 4; i++)
+        if (overrides->stick_keys_set & (1u << i)) base->stick_keys[i] = overrides->stick_keys[i];
+    base->stick_keys_set |= overrides->stick_keys_set;
+    base->set |= overrides->set & (SET_MODE | SET_MOUSE | SET_SPEED | SET_KEYBOARD_STICK | SET_STICK_DEADZONE);
     for (size_t i = 0; i < PW_GAME_BUTTON_COUNT; i++)
         if (overrides->bindings[i].kind != PW_GAME_BIND_UNSET) base->bindings[i] = overrides->bindings[i];
 }
