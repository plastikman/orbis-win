From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] wow64cpu: log bounded reset-state return context

Record the saved WOW64 context before BTCpuSimulate enters the reset-state
syscall_32to64_return path. Bound the output to the first sixteen entries so a
translator startup fault can be correlated without flooding the console log.

This patch follows 1018, which applies the PS4 selectors to the IRET frame.

--- a/dlls/wow64cpu/cpu.c
+++ b/dlls/wow64cpu/cpu.c
@@ -276,6 +276,29 @@
 /**********************************************************************
  *           BTCpuSimulate  (wow64cpu.@)
  */
+static LONG wow64_context_trace_count;
+
+void wow64cpu_log_context( const CONTEXT *context )
+{
+    LONG n = InterlockedIncrement( &wow64_context_trace_count );
+
+    if (n > 16) return;
+    ERR( "PW_WOW64_PRE_IRET n=%ld rip=%08lx%08lx rsp=%08lx%08lx cs=%04x ss=%04x eflags=%08lx "
+         "rax=%08lx%08lx rbx=%08lx%08lx rcx=%08lx%08lx rdx=%08lx%08lx "
+         "rsi=%08lx%08lx rdi=%08lx%08lx rbp=%08lx%08lx r8=%08lx%08lx r9=%08lx%08lx\n",
+         n, (ULONG)(context->Rip >> 32), (ULONG)context->Rip,
+         (ULONG)(context->Rsp >> 32), (ULONG)context->Rsp, context->SegCs, context->SegSs,
+         context->EFlags, (ULONG)(context->Rax >> 32), (ULONG)context->Rax,
+         (ULONG)(context->Rbx >> 32), (ULONG)context->Rbx,
+         (ULONG)(context->Rcx >> 32), (ULONG)context->Rcx,
+         (ULONG)(context->Rdx >> 32), (ULONG)context->Rdx,
+         (ULONG)(context->Rsi >> 32), (ULONG)context->Rsi,
+         (ULONG)(context->Rdi >> 32), (ULONG)context->Rdi,
+         (ULONG)(context->Rbp >> 32), (ULONG)context->Rbp,
+         (ULONG)(context->R8 >> 32), (ULONG)context->R8,
+         (ULONG)(context->R9 >> 32), (ULONG)context->R9 );
+}
+
 __ASM_GLOBAL_FUNC( BTCpuSimulate,
                    "pushq %rbp\n\t"
                    ".seh_pushreg %rbp\n\t"
@@ -291,6 +314,8 @@
                    "movq %gs:0x30,%r12\n\t"
                    "movq 0x1488(%r12),%rcx\n\t" /* NtCurrentTeb()->TlsSlots[WOW64_TLS_CPURESERVED] */
                    "leaq 4(%rcx),%r13\n\t"      /* cpu->Context */
+                   "movq %r13,%rcx\n\t"
+                   "call " __ASM_NAME("wow64cpu_log_context") "\n\t"
                    "movl cs32_sel(%rip),%eax\n\t"
                    "movl %eax,0xbc(%r13)\n\t"   /* context->SegCs */
                    "movl ss32_sel(%rip),%eax\n\t"
