; A keyboard-and-mouse 3D game, as the Oblivion profile plays: the left stick
; walks with W A S D, the right stick looks around as the mouse, R2 clicks and
; L2 right-clicks. Cross Space, Circle Ctrl, Square E, Triangle R, L1 Q,
; R1 F, L3 Shift, R3 middle click, the d-pad the arrows, Options Escape,
; Create Tab, the touchpad Enter. Change single buttons on the game card.
[input]
mode = keyboard
mouse = right_stick
mouse_speed = 1200
keyboard_stick = left_stick
stick_deadzone = 25
r2 = mouse_left
l2 = mouse_right
cross = space
circle = ctrl
square = e
triangle = r
l1 = q
r1 = f
l3 = shift
r3 = mouse_middle
up = up
down = down
left = left
right = right
options = escape
create = tab
touchpad = enter
