; Grand Theft Auto IV (test): generated by tools/pw_install.py from a Lutris installer script.

[application]
id = gtaiv-test
name = Grand Theft Auto IV (test)
executable = C:\Games\GTAIV\GTAIV.exe
working_directory = C:\Games\GTAIV
arguments = -availablevidmem 1536 -nomemrestrict -norestrictions -width 1920 -height 1080 -refreshrate 60 -fullscreen -rglLanguage en-US
dll_overrides = d3d8,d3d9,d3d10core,d3d11,dxgi=n;dinput8=n,b
prefix = gtaiv-test
runtime = wine-wow64
architecture = pe32
graphics = dxvk

[display]
desktop = 1920x1080

[debug]
winedebug = +fps,+loaddll,+d3d,+vulkan
env = DXVK_LOG_LEVEL=debug

[input]
mode = xinput

[runtime]

cpu = native
