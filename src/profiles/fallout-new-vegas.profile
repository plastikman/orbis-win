; Fallout: New Vegas: generated by tools/pw_install.py from a Lutris installer script.
[application]
id = fallout-new-vegas
name = Fallout: New Vegas
executable = C:\Games\FalloutNV\FalloutNV.exe
working_directory = C:\Games\FalloutNV
dll_overrides = d3d8,d3d9,d3d10core,d3d11,dxgi=n
prefix = fallout-new-vegas
runtime = wine-wow64
architecture = pe32
graphics = dxvk

[display]
desktop = 1920x1080
scaling = fit

[input]
mode = xinput

[runtime]
cpu = native

[debug]
env = PW_NATIVE_PROFILE=1
env = PW_NATIVE_PC=1
env = PW_PS4_FORCE_EXEC=0
env = PW_WINESERVER_HEAP_DIRECT=1
env = PW_WINESERVER_HEAP_TRACE=1
winedebug = +seh
