  *
  * ac_orbis_drm.c splits the same way and states the principle: -Dplatforms=orbis selects the ARM, not the
@@ -1049,6 +1168,10 @@ wsi_orbis_scanout_present(struct wsi_orbis_scanout *so, uint32_t index, const vo
     * measuring alongside. `src` holds the same pixels in the driver's cached ONION arena. */
    wsi_orbis_frame_stats(src, so->src_width, so->src_height, src_pitch);
 
+   /* Overlay the desktop cursor after the scene has been copied and before
+    * video-out takes ownership of this buffer. */
+   wsi_orbis_cursor_composite(dst, dst_pitch, so->width, so->height);
+
    if (trace)
       mesa_logi("wsi/orbis: present copied %u KiB, flipping index %u",
                 (unsigned)((uint64_t)dst_pitch * so->height / 1024), index);
